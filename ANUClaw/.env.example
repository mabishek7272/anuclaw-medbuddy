# ============================================================
# ANUClaw Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Options: anthropic | openrouter | openai-compatible | openai-codex | ollama
MODEL_PROVIDER=anthropic

# Anthropic (default)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenRouter (access 200+ models: deepseek, gemini, gpt, claude, etc.)
# MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1

# OpenAI-compatible endpoint
# MODEL_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_API_KEY=your_key
# OPENAI_COMPATIBLE_BASE_URL=https://your-provider.example/v1
# OPENAI_COMPATIBLE_MODEL=your-model-name

# OpenAI / Codex (reuse local codex login)
# MODEL_PROVIDER=openai-codex
# OPENAI_CODEX_MODEL=gpt-4o

# Ollama (local models — no API key needed)
# MODEL_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── E-LAB clinical AI safety (BAA / PHI de-identification) ────
# Whether the configured model provider above is covered by a signed BAA.
# Default false. When false, E-LAB de-identifies clinical free text BEFORE it
# is sent to the provider, then re-identifies the output locally.
LLM_BAA_COVERED=false
# Require de-identification before egress when the provider is not BAA-covered.
# Keep true for pharmacy/clinic use. (Set false only for de-identified test data.)
ELAB_DEID_REQUIRED=true

# ── Channel Tokens ───────────────────────────────────────────
# Enable only the channels you use. Unset = disabled.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_TRIGGER=@ANUClaw

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Feishu / Lark
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# DingTalk
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# Gmail / Email
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ADDRESS=

# Signal
SIGNAL_CLI_PATH=/usr/local/bin/signal-cli
SIGNAL_PHONE_NUMBER=

# Matrix
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_USER_ID=
MATRIX_ACCESS_TOKEN=
MATRIX_ROOM_ID=

# iMessage (macOS only)
IMESSAGE_ENABLED=false
IMESSAGE_HANDLE=

# IRC
IRC_SERVER=irc.libera.chat
IRC_PORT=6697
IRC_NICK=ANUClaw
IRC_CHANNEL=#anuclaw

# Nostr
NOSTR_PRIVATE_KEY=
NOSTR_RELAY=wss://relay.damus.io

# QQ (OpenShamrock)
QQ_WEBSOCKET_URL=ws://localhost:3001
QQ_ACCESS_TOKEN=

# WhatsApp (auto-detected when enabled)
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_DIR=.whatsapp-auth

# Local Web UI
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=3721
WEB_PASSWORD=

# ── Agent Settings ───────────────────────────────────────────
TRIGGER_PATTERN=@ANUClaw
MAX_SESSION_MESSAGES=80
CONTAINER_TIMEOUT_MS=300000
CONTAINER_IMAGE=anuclaw-agent:latest
WORKSPACE_DIR=./workspace
GROUPS_DIR=./groups

# ── Hooks ────────────────────────────────────────────────────
HOOKS_ENABLED=true
# HOOKS_CONFIG=./hooks.config.yaml

# ── Memory ───────────────────────────────────────────────────
# dual = file memory (AGENTS.md) + SQLite structured facts
MEMORY_MODE=dual
MEMORY_COMPACTION_THRESHOLD=80

# ── SOUL / Personality ───────────────────────────────────────
# Defaults to ./SOUL.md at project root
# SOUL_PATH=./SOUL.md

# ── Voice Transcription ──────────────────────────────────────
WHISPER_ENABLED=false
# Options: openai-api | local-whisper
WHISPER_BACKEND=openai-api
WHISPER_API_KEY=
# For local whisper.cpp (Apple Silicon)
# WHISPER_MODEL_PATH=./models/ggml-base.bin

# ── Database ─────────────────────────────────────────────────
DB_PATH=./anuclaw.db

# ── PostgreSQL Database ──────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=anuclaw


# ── ANUClaw Dashboard ────────────────────────────────────────
# Set to 'false' to disable the dashboard
DASHBOARD_ENABLED=true

# Port the dashboard server listens on
DASHBOARD_PORT=3722

# Secret for dashboard JWT — CHANGE THIS in production (can be same as ANUCLAW_JWT_SECRET)
DASHBOARD_JWT_SECRET=change-me-dashboard-secret

# ── ANUClaw API Platform ──────────────────────────────────────
# Set to 'false' to disable the API server (messaging-only mode)
API_ENABLED=true

# Port the API server listens on
API_PORT=4000

# Secret used to sign JWT tokens — CHANGE THIS in production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ANUCLAW_JWT_SECRET=change-me-to-a-long-random-secret

# SQLite database for tenant/company registrations and API keys
ANUCLAW_TENANT_DB=./data/tenants.db

# SQLite database for patient UID registry (EHR authority store)
ANUCLAW_UID_REGISTRY=./data/uid_registry.db

# Comma-separated list of allowed CORS origins (use * for open access)
# Example: CORS_ORIGINS=https://app.mycompany.com,https://dashboard.mycompany.com
CORS_ORIGINS=*

# ── CDS v3 — SMART on FHIR / CDS Hooks auth (plan §6.5) ───────
# Guards the /cds-services invocation and /cds/review/* endpoints.
# Auth is OFF until a key is configured (or set CDS_AUTH_ENABLED to force on/off).
# RS256: paste the issuer's public-key PEM (use \n for newlines), OR
# HS256: set a shared secret (dev only).
CDS_JWT_PUBLIC_KEY=
CDS_JWT_SECRET=
# JWKS endpoint URL (preferred for multi-tenant: key resolved by `kid`, cached)
CDS_JWKS_URI=
# Require asymmetric algorithms only (RS/ES); rejects HS256. Recommended for clinical.
CDS_REQUIRE_ASYMMETRIC=true
# Comma-separated allowlist of token issuers (EHR / SMART auth server `iss`)
CDS_TRUSTED_ISSUERS=
# Expected audience (`aud`) — this CDS service's public URL
CDS_AUDIENCE=
# Scopes required for review/read endpoints, and additionally for sign-off
CDS_REQUIRED_SCOPES=user/Patient.read
CDS_SIGNOFF_SCOPES=user/MedicationRequest.write
# Force on/off (overrides key-based auto-detection)
# CDS_AUTH_ENABLED=true

# Admin API key for tenant clinical-grant management (X-Admin-Key header).
# Leave blank to DISABLE the admin API entirely (fail-closed → 503).
ADMIN_API_KEY=

# ── Logging ──────────────────────────────────────────────────
# Options: debug | info | warn | error
LOG_LEVEL=info
LOG_FILE=./logs/anuclaw.log
